{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git range-diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git cat-file *)"
    ],
    "deny": [
      "Read(//**/*.env*)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials*)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*.tfvars)",
      "Read(//**/*.tfstate*)",
      "Read(//**/.git-credentials)",
      "Read(//**/.netrc)",
      "Read(//**/.npmrc)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*kubeconfig*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.zshrc)",
      "Read(~/.zshenv)",
      "Read(~/.bashrc)",
      "Read(~/.bash_profile)",
      "Edit(//**/*.env*)",
      "Edit(//**/secrets/**)",
      "Edit(//**/credentials*)",
      "Edit(//**/*.key)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.tfvars)",
      "Edit(//**/*.tfstate*)",
      "Edit(//**/.git-credentials)",
      "Edit(//**/.netrc)",
      "Edit(//**/.npmrc)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/id_ed25519*)",
      "Edit(//**/*kubeconfig*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.config/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Bash(git credential *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(gh *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git config *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch --move *)",
      "Bash(git branch -c *)",
      "Bash(git branch -C *)",
      "Bash(git branch --copy *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git branch -u *)",
      "Bash(git branch --set-upstream-to*)",
      "Bash(git branch --unset-upstream*)",
      "Bash(git branch -t *)",
      "Bash(git branch --track*)",
      "Bash(git branch --no-track *)",
      "Bash(git branch --edit-description*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "code.claude.com",
        "api.anthropic.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "docs.aws.amazon.com",
        "dev.classmethod.jp",
        "www.googleapis.com"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "//**/*.env*",
        "//**/*.conf",
        "//**/secrets/**",
        "//**/credentials*",
        "//**/*.key",
        "//**/*.pem",
        "//**/*.tfvars",
        "//**/*.tfstate*",
        "//**/.git-credentials",
        "//**/.netrc",
        "//**/.npmrc",
        "//**/id_rsa*",
        "//**/id_ed25519*",
        "//**/*kubeconfig*",
        "//**/.devcontainer/**",
        "//**/.vscode/**",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.docker/config.json",
        "~/.config/**",
        "~/.kube/**",
        "~/.zshrc",
        "~/.zshenv",
        "~/.bashrc",
        "~/.bash_profile"
      ],
      "denyRead": [
        "//**/*.env*",
        "//**/*.conf",
        "//**/secrets/**",
        "//**/credentials*",
        "//**/*.key",
        "//**/*.pem",
        "//**/*.tfvars",
        "//**/*.tfstate*",
        "//**/.git-credentials",
        "//**/.netrc",
        "//**/.npmrc",
        "//**/id_rsa*",
        "//**/id_ed25519*",
        "//**/*kubeconfig*",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.docker/config.json",
        "~/.kube/**",
        "~/.zshrc",
        "~/.zshenv",
        "~/.bashrc",
        "~/.bash_profile"
      ]
    }
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
