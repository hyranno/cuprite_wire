(export (version "E")
  (design (tool "cuprite_wire 0.3.0"))
  (components
    (comp (ref "C1")
      (value "100n")
      (footprint "Capacitor_SMD:C_0603_1608Metric")
      (libsource (lib "Device") (part "C"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "771a0cf3-c320-53ca-b94c-79c2f220b288"))
    (comp (ref "R1")
      (value "1k")
      (footprint "Resistor_SMD:R_0603_1608Metric")
      (libsource (lib "Device") (part "R"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "dc6b8f6c-8a2c-5cc5-9de6-7d2160446752"))
    (comp (ref "R2")
      (value "10k")
      (footprint "Resistor_SMD:R_0603_1608Metric")
      (libsource (lib "Device") (part "R"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "17ad9b29-3fd1-52e2-a005-c623d0c4e8d8"))
    (comp (ref "R3")
      (value "22k")
      (footprint "Resistor_SMD:R_0603_1608Metric")
      (libsource (lib "Device") (part "R"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "456b8c16-1e81-50d2-9824-47ab38d7bf05")))
  (nets
    (net (code "1")
      (name "/IN")
      (class "Default")
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive")))
    (net (code "2")
      (name "/OUT")
      (class "Default")
      (node (ref "C1") (pin "1") (pintype "passive"))
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "R3") (pin "1") (pintype "passive")))
    (net (code "3")
      (name "GND")
      (class "Default")
      (node (ref "C1") (pin "2") (pintype "passive"))
      (node (ref "R3") (pin "2") (pintype "passive")))
    (net (code "4")
      (name "unconnected-(R1-Pad2)")
      (class "Default")
      (node (ref "R1") (pin "2") (pintype "passive")))))
