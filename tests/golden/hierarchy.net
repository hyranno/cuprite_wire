      (sheetpath (names "/stage1/") (tstamps "/ef695247-7c64-56d8-ac17-08ac86b88d7d/"))
      (tstamps "5fdc7270-536c-567c-8483-5082b28fb55d"))
    (comp (ref "R1")
      (value "1k")
      (footprint "Resistor_SMD:R_0603_1608Metric")
