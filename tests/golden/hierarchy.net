      (sheetpath (names "/RcStage#1/") (tstamps "/c6b2ff48-7e10-53c4-bd14-3dab21d3190d/"))
      (tstamps "6d9b1e91-a280-5a23-b270-4210fe4c8586"))
    (comp (ref "R2")
